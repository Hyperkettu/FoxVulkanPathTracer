  <!-- Optional: NVIDIA DLSS Ray Reconstruction. Enabled automatically when the DLSS SDK has been
       cloned into ThirdParty\DLSS next to the solution (see the readme); without it the project
       builds as usual and the DLSS denoiser is simply not compiled in. -->
  <PropertyGroup>
    <DlssSdkDir>$(SolutionDir)ThirdParty\DLSS\</DlssSdkDir>
    <FoxEnableDlss Condition="'$(Platform)'=='x64' And Exists('$(DlssSdkDir)include\nvsdk_ngx.h')">true</FoxEnableDlss>
    <!-- NGX import library built against the dynamic CRT; the _dbg variant matches Debug (/MDd) -->
    <DlssNgxLib>nvsdk_ngx_d.lib</DlssNgxLib>
    <DlssNgxLib Condition="'$(Configuration)'=='Debug'">nvsdk_ngx_d_dbg.lib</DlssNgxLib>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(FoxEnableDlss)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>FOX_ENABLE_DLSS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(DlssSdkDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DlssSdkDir)lib\Windows_x86_64\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(DlssNgxLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <!-- Builds the C# scripting host (Scripting/FoxScripting) into $(OutDir)Scripting, and copies the .NET hosting API
       (hostfxr.h, coreclr_delegates.h) from the installed SDK to x64/nethost for this project's includes.
       Needs the .NET 10 SDK. -->
  <Target Name="BuildScripting" BeforeTargets="ClCompile" Inputs="@(ScriptingSource)" Outputs="$(OutDir)Scripting\FoxScripting.dll">
    <Exec Command="dotnet build &quot;$(ProjectDir)Scripting\FoxScripting\FoxScripting.csproj&quot; -c $(Configuration) -nologo -v:minimal -o &quot;$(OutDir)Scripting&quot; -p:NativeHostOut=&quot;$(SolutionDir)x64\nethost&quot;" />
  </Target>
  <ItemGroup>
    <ScriptingSource Include="Scripting\FoxScripting\*.cs;Scripting\FoxScripting\*.csproj" />
  </ItemGroup>
  <!-- Compiles the Slang shaders with the Vulkan SDK's slangc. Incremental: a shader is only
       rebuilt when it, or one of the shared SlangInclude files, is newer than its .spv output. -->
  <Target Name="CompileSlangShaders" BeforeTargets="ClCompile" Inputs="@(SlangShader);@(SlangInclude)" Outputs="@(SlangShader->'$(ProjectDir)Shaders\%(Filename)%(Suffix).spv')">
    <Error Condition="'$(VULKAN_SDK)' == ''" Text="The VULKAN_SDK environment variable is not set. Install the Vulkan SDK (it provides the headers, SDL2, glm and the slangc shader compiler)." />
    <Message Importance="high" Text="slangc %(SlangShader.Identity) %(SlangShader.Defines)" />
    <Exec Command="&quot;$(VULKAN_SDK)\Bin\slangc.exe&quot; &quot;%(SlangShader.FullPath)&quot; -stage %(SlangShader.Stage) -entry main -profile %(SlangShader.Profile) %(SlangShader.Defines) -target spirv -o &quot;$(ProjectDir)Shaders\%(SlangShader.Filename)%(SlangShader.Suffix).spv&quot;" />
  </Target>
  <!-- NGX loads the Ray Reconstruction model from the executable's folder -->
  <Target Name="CopyDlssRuntime" AfterTargets="Build" Condition="'$(FoxEnableDlss)'=='true'">
    <Copy SourceFiles="$(DlssSdkDir)lib\Windows_x86_64\rel\nvngx_dlssd.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>